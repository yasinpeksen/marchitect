# ============================================================================
# Meta Ads Intelligence - environment. Copy to .env (or run scripts/setup-env).
# ============================================================================

# ---- Supabase (choose ONE: cloud project OR local CLI stack) ----------------
# URL the BROWSER uses to reach Supabase Auth/Storage.
#   Cloud : https://<project-ref>.supabase.co
#   Local : http://localhost:54321
SUPABASE_URL=http://localhost:54321
# URL the BACKEND/WORKER containers use. Leave EMPTY for cloud.
#   Local : http://host.docker.internal:54321
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321
# Public anon / publishable key (safe for the browser).
SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY - never exposed to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used only by `docker compose run --rm migrate`.
#   Cloud : Project Settings > Database > Connection string (session pooler / direct)
#   Local : postgresql://postgres:postgres@host.docker.internal:54322/postgres
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
# Private storage bucket for ad media (created by the migrations).
SUPABASE_MEDIA_BUCKET=ad-media

# ---- App URLs / ports --------------------------------------------------------
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ---- Secrets (generated by scripts/setup-env) ------------------------------
# 32 random bytes, hex (64 chars) or base64. Encrypts Meta tokens at rest. Rotating it
# invalidates stored tokens (users must reconnect).
TOKEN_ENCRYPTION_KEY=
REDIS_PASSWORD=

# ---- Meta (Graph / Marketing API) --------------------------------------------
# Needed for "Connect with Facebook" OAuth. Without them you can still paste a token.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/meta/oauth/callback
# Pin the Graph API version; upgrade deliberately before Meta sunsets it.
META_GRAPH_VERSION=v24.0
META_MAX_RETRIES=5
# Optional, separate Ad Library integration (subject to Meta eligibility).
META_AD_LIBRARY_ENABLED=false

# ---- Collection tuning -------------------------------------------------------
COLLECTION_DEFAULT_LOOKBACK_DAYS=30
MAX_ADS_PER_RUN=2000
ASYNC_INSIGHTS_MIN_DAYS=31
ASYNC_INSIGHTS_MIN_ADS=100
MEDIA_MAX_BYTES=524288000
SIGNED_URL_TTL_SECONDS=3600
WORKER_COLLECTION_CONCURRENCY=2
WORKER_MEDIA_CONCURRENCY=3
SCHEDULER_TICK_MS=60000

# ---- Operations --------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Optional error monitoring.
SENTRY_DSN=
