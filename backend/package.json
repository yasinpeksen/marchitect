{
  "name": "markhitect-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Meta Ads Intelligence - NestJS API and background workers",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "migrate": "node dist/scripts/migrate.js",
    "migrate:dev": "ts-node src/scripts/migrate.ts",
    "test": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config test/jest-integration.json --runInBand"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@sentry/node": "^9.0.0",
    "@supabase/supabase-js": "^2.50.0",
    "bullmq": "^5.40.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "luxon": "^3.5.0",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.39.5",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*.spec.ts$",
    "transform": {
      "^.+.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.module.ts",
      "!main.ts",
      "!worker.ts",
      "!scripts/migrate.ts",
      "!testing/**",
      "!common/types.ts"
    ],
    "coverageDirectory": "../coverage",
    "setupFiles": [
      "<rootDir>/testing/silence-logs.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 97,
        "lines": 97,
        "functions": 95,
        "branches": 85
      }
    }
  }
}
